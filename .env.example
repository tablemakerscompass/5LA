# ---------------------------------------------------------------------------
# Work With Us — inquiry delivery
#
# Configure ONE of the two transports below. With neither set, the inquiry
# form returns a clear "not connected yet" message rather than accepting and
# silently dropping a real inquiry.
#
# Set these in the hosting provider's environment settings (Vercel → Project →
# Settings → Environment Variables). Never commit real keys to the repository.
# ---------------------------------------------------------------------------

# --- Option 1: email via Resend (https://resend.com) ---
# RESEND_API_KEY must be a Resend API key, and INQUIRY_FROM_EMAIL must be an
# address on a domain verified in that Resend account.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=inquiries@the5loavesagency.com

# Where inquiries are delivered. Defaults to site.contact.email when unset.
INQUIRY_TO_EMAIL=admin@the5loavesagency.com

# Interim setup, until a domain is verified in Resend and a mailbox exists on
# the5loavesagency.com. Resend's sandbox sends only from onboarding@resend.dev,
# and only to the address the Resend account was registered with — so both
# values below are fixed by Resend, not chosen:
#   INQUIRY_FROM_EMAIL=onboarding@resend.dev
#   INQUIRY_TO_EMAIL=the5loavesagency@gmail.com
# Replace both once the domain is verified; the sandbox cannot reach anyone
# else, so a typo here means inquiries fail rather than go astray.

# --- Option 2: webhook (Zapier, Make, n8n, or a custom endpoint) ---
# Receives the inquiry as JSON via POST. Used only when the Resend variables
# above are not set.
INQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the X-5LA-Signature request header.
INQUIRY_WEBHOOK_SECRET=
